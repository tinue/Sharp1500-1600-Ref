10 MAXFILES=1:OPEN "S2:T.DAT" FOR OUTPUT AS #1
20 PRINT#1,"2*3":PRINT#1,"B$":PRINT#1,"HELLO"
30 CLOSE #1
40 B$="XY":HE=7
50 OPEN "S2:T.DAT" FOR INPUT AS #1
60 INPUT#1,A,C,D
70 CLOSE #1
80 PRINT A;"/";C;"/";D
90 END
100 "U" MAXFILES=1:ON ERROR GOTO 200
120 OPEN "S2:U.DAT" FOR OUTPUT AS #1
130 PRINT#1,USING "##.##";1/0
140 END
200 E=ERN:L=ERL:CLOSE #1:PRINT E;L;3.14159:END
300 "V" MAXFILES=1:ON ERROR GOTO 400:USING "###.#"
320 OPEN "S2:V.DAT" FOR OUTPUT AS #1
330 PRINT#1,1/0
340 END
400 E=ERN:L=ERL:CLOSE #1:PRINT E;L;3.14159:END
500 "W" USING "###.#":PRINT 3.14159
